    {
      "name": "02. Pilot Authentication & Access",
      "item": [
        {
          "name": "1. Register Pilot Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.environment.set('token', json.token);",
                  "        console.log('Pilot token auto-saved to environment:', json.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
